<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <PropertyGroup>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ApplicationIcon />
        <StartupObject />
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>..\bin\app_debug</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>..\bin\app</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <None Update="Configs\app_log.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.Apps\GameFrameX.Apps.csproj" />
        <ProjectReference Include="..\GameFrameX.Config\GameFrameX.Config.csproj" />
        <ProjectReference Include="..\GameFrameX.Proto\GameFrameX.Proto.csproj" />
        <ProjectReference Include="..\GameFrameX.Architecture.Analyzers\GameFrameX.Architecture.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GameFrameX.StartUp" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Utility" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Localization" Version="2.0.0" />
        <PackageReference Include="GameFrameX.DataBase.Mongo" Version="2.0.0" />
        <PackageReference Include="GameFrameX.DataBase.Sqlite" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Network" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Network.RemoteMessaging" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Foundation.Localization" Version="5.0.0" />
        <PackageReference Include="GameFrameX.SuperSocket.ClientEngine" Version="1.3.0" />
        <PackageReference Include="GameFrameX.Capability.Hosting.Abstractions" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Hosting.Core" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Hosting.AdminApi" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Abstractions" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Foundation" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Assets" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Social" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Matchmaking" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Match" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Leaderboard" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Competition" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Operations" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Persistence" Version="2.0.0" />
    </ItemGroup>
</Project>
