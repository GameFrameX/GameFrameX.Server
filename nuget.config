<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- GameFrameX-Internal：内部验证 feed（相对本仓的同级目录）。
             2.0 包尚未发布到 nuget.org（发布由框架仓 backlog 跟踪）——普通克隆若无法解析本源，
             dotnet restore 将以 NU1301 失败；请把 GameFrameX 2.0.0 包放入同级 LocalPackages 目录，
             或将本源改指向你自己的 feed 后再还原。 -->
        <add key="GameFrameX-Internal" value="../LocalPackages" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
