<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>

        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.Hotfix\GameFrameX.Hotfix.csproj" />
        <ProjectReference Include="..\GameFrameX.Launcher\GameFrameX.Launcher.csproj" />
        <PackageReference Include="GameFrameX.Capability.Hosting.Abstractions" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Hosting.AdminApi" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Hosting.Core" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Abstractions" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Social" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Matchmaking" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Match" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Assets" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Leaderboard" Version="2.0.0" />
        <PackageReference Include="GameFrameX.Capability.Online.Competition" Version="2.0.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
        <PackageReference Include="xunit" Version="2.9.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <Target Name="RemoveOpenApiSourceGeneratorFromTests" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
        </ItemGroup>
    </Target>

</Project>
